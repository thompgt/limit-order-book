<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thompgt.lob</groupId>
    <artifactId>limit-order-book</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>engine-bench</artifactId>
  <name>engine-bench</name>
  <description>JMH throughput and HdrHistogram tail-latency harness for engine-core</description>

  <properties>
    <!-- Benchmarks are opt-in: an ordinary `./mvnw verify` must not run them. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.thompgt.lob</groupId>
      <artifactId>engine-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.hdrhistogram</groupId>
      <artifactId>HdrHistogram</artifactId>
    </dependency>

    <!-- The benchmark is only meaningful if its workload holds the book at a
         fixed depth and never trips a reject. Both are asserted, not assumed. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            JMH discovers benchmarks at build time with an annotation processor
            that writes META-INF/BenchmarkList. Since JDK 23, javac no longer
            runs processors it merely finds on the classpath, so this has to be
            asked for by name. Without it everything compiles, the shaded jar
            builds, and the run dies with "Unable to find the resource:
            /META-INF/BenchmarkList" - a build that succeeds and produces
            nothing measurable.
          -->
          <proc>full</proc>
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${jmh.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      -Pbench builds a self-contained benchmarks.jar and runs it during `verify`.

        ./mvnw -pl engine-bench -am -Pbench verify
    -->
    <profile>
      <id>bench</id>
      <properties>
        <!-- Override on the command line, e.g. -Dbench.rate=1000000 -->
        <bench.rate>500000</bench.rate>
        <bench.seconds>20</bench.seconds>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <executions>
              <execution>
                <id>bench-jar</id>
                <phase>package</phase>
                <goals><goal>shade</goal></goals>
                <configuration>
                  <finalName>benchmarks</finalName>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>org.openjdk.jmh.Main</mainClass>
                    </transformer>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                        <exclude>module-info.class</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>run-benchmarks</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-jar</argument>
                    <argument>${project.build.directory}/benchmarks.jar</argument>
                    <argument>-prof</argument>
                    <argument>gc</argument>
                    <argument>-rf</argument>
                    <argument>json</argument>
                    <argument>-rff</argument>
                    <argument>${project.build.directory}/jmh-result.json</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- Throughput and latency answer different questions, so they
                   are measured separately. JMH runs the engine as fast as it
                   will go; the harness below offers a fixed rate and reports
                   what the tail looks like from the caller's side. -->
              <execution>
                <id>run-latency-harness</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-Xms2g</argument>
                    <argument>-Xmx2g</argument>
                    <argument>-cp</argument>
                    <argument>${project.build.directory}/benchmarks.jar</argument>
                    <argument>io.github.thompgt.lob.bench.LatencyHarness</argument>
                    <argument>--rate</argument>
                    <argument>${bench.rate}</argument>
                    <argument>--seconds</argument>
                    <argument>${bench.seconds}</argument>
                    <argument>--out</argument>
                    <argument>${project.build.directory}/latency.txt</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
